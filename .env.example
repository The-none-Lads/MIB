# ==========================================
# MIB DIGITAL IDENTITY SYSTEM — ENVIRONMENT TEMPLATE
# ==========================================

# Application Environment (development, testing, production)
ENVIRONMENT=production
DEBUG=false
APP_DOMAIN=mib.gameserver1.cc

# Security
SECRET_KEY=change_me_to_a_secure_random_64_char_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (PostgreSQL)
POSTGRES_USER=mib_user
POSTGRES_PASSWORD=replace_with_strong_password_in_production
POSTGRES_DB=mib_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://mib_user:replace_with_strong_password_in_production@db:5432/mib_db

# Frontend / CORS
CORS_ORIGINS=["https://mib.gameserver1.cc","http://localhost:5173","http://localhost:3000"]

# File Storage
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_BYTES=5242880
